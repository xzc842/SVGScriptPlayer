{
  "name": "svg-script-player",
  "version": "0.1.6",
  "description": "用文本脚本描述 SVG 动画和交互场景的运行时，支持浏览器实时播放与 Node 端 FFmpeg 渲染成视频",
  "type": "module",
  "license": "MIT",
  "author": "xzc842",
  "keywords": [
    "svg",
    "animation",
    "script",
    "player",
    "ffmpeg",
    "video",
    "ai",
    "generative"
  ],
  "homepage": "https://github.com/xzc842/SVGScriptPlayer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzc842/SVGScriptPlayer.git"
  },
  "bugs": {
    "url": "https://github.com/xzc842/SVGScriptPlayer/issues"
  },
  "main": "./dist/svg-script-player.node.cjs",
  "module": "./dist/svg-script-player.esm.js",
  "browser": "./dist/svg-script-player.esm.js",
  "unpkg": "./dist/svg-script-player.umd.js",
  "jsdelivr": "./dist/svg-script-player.umd.js",
  "exports": {
    ".": {
      "browser": "./dist/svg-script-player.esm.js",
      "node": {
        "import": "./dist/svg-script-player.node.js",
        "require": "./dist/svg-script-player.node.cjs"
      },
      "import": "./dist/svg-script-player.esm.js",
      "default": "./dist/svg-script-player.esm.js"
    },
    "./node": {
      "import": "./dist/svg-script-player.node.js",
      "require": "./dist/svg-script-player.node.cjs"
    },
    "./browser": {
      "default": "./dist/svg-script-player.esm.js"
    },
    "./templates": {
      "default": "./dist/svg-script-player.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README*.md",
    "LICENSE",
    "docs",
    "ToDo.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\"",
    "example:browser": "vite examples/browser",
    "example:browser:build": "vite build examples/browser",
    "example:render": "node examples/node/render.js",
    "example:render:demo2": "node examples/node/render.js demo2.txt",
    "example:render:gif": "node examples/node/render-gif.js",
    "example:render:frames": "node examples/node/render-frames.js",
    "example:render:batch": "node examples/node/batch-render.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "sharp": "^0.35.4"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "rollup": "^4.21.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
