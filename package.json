{
  "name": "svg-script-player",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/svg-script-player.node.js",
  "module": "./dist/svg-script-player.esm.js",
  "browser": "./dist/svg-script-player.esm.js",
  "exports": {
    ".": {
      "browser": "./dist/svg-script-player.esm.js",
      "node": "./dist/svg-script-player.node.js",
      "default": "./dist/svg-script-player.esm.js"
    },
    "./node": {
      "node": "./dist/svg-script-player.node.js"
    },
    "./templates": {
      "default": "./dist/svg-script-player.esm.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:browser": "vite examples/browser",
    "example:node": "node examples/node/render.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "rollup": "^4.0.0",
    "vitest": "^1.0.0",
    "vite": "^5.0.0"
  }
}